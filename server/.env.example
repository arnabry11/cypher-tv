# Daily run, local time (the container runs in Asia/Kolkata).
CYPHER_RUN_AT=01:00
# Seconds the guide grab may take. Slower is kinder to the guide sites and covers more channels.
CYPHER_BUDGET_SECONDS=3600
# 1 = build and check everything but push nothing.
CYPHER_DRY_RUN=0
# Telegram alerts on failure and recovery. Leave empty to turn them off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
